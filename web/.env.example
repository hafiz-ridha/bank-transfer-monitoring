# ---------------------------------------------------------------------------
# Web Dashboard - Bank Transfer Monitoring System
# Salin menjadi .env.local untuk PENGEMBANGAN (`npm run dev`).
# PRODUKSI tidak memakai file ini: dashboard disajikan backend dalam satu container dan
# membaca URL/anon key Supabase saat runtime dari /app-config.js (.env backend).
# ---------------------------------------------------------------------------

# URL dasar backend API saat `next dev` (tanpa /api/v1). Kosong = origin yang sama.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Mode autentikasi dashboard:
#   supabase -> login email + password via Supabase Auth (PRODUKSI)
#   dev      -> login hanya dengan email, token "dev:<email>" (HANYA lokal,
#               backend juga harus AUTH_MODE=dev). Menampilkan badge "MODE DEV".
NEXT_PUBLIC_AUTH_MODE=supabase

# Wajib jika NEXT_PUBLIC_AUTH_MODE=supabase (Supabase > Project Settings > API).
# Gunakan anon/public key, JANGAN service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Interval auto refresh (ms) untuk dashboard, perangkat, detail perangkat, alert.
# Default 15000. Polling berhenti saat tab browser tidak aktif.
NEXT_PUBLIC_REFRESH_MS=15000

# Nama aplikasi yang tampil di sidebar & judul tab (opsional).
NEXT_PUBLIC_APP_NAME=Bank Transfer Monitor
