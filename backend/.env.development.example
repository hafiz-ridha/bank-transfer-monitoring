# Mode pengembangan lokal TANPA Supabase: database PGlite (file lokal) + login dev.
# Salin menjadi .env lalu jalankan: npm run dev
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
DB_DRIVER=pglite
PGLITE_DATA_DIR=./data/pglite
AUTH_MODE=dev
BOOTSTRAP_ADMIN_EMAILS=admin@local.test
JOBS_ENABLED=true
