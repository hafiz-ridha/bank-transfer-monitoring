# ---------------------------------------------------------------- Server
NODE_ENV=production
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
# Di belakang Nginx (HestiaCP) agar IP klien & rate limit benar
TRUST_PROXY=true
# Origin web dashboard (pisahkan dengan koma)
CORS_ORIGINS=https://dashboard.contoh.co.id
# URL dashboard untuk tautan undangan user (default: origin CORS pertama)
DASHBOARD_URL=https://dashboard.contoh.co.id

# ---------------------------------------------------------------- Database (Supabase PostgreSQL)
# Supabase > Project Settings > Database > Connection string (gunakan Session pooler / port 5432
# karena backend memakai transaksi & row-level locking).
DB_DRIVER=pg
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
DB_POOL_MAX=10
# Jalankan migrasi otomatis saat start (atau jalankan manual: npm run migrate)
AUTO_MIGRATE=false

# ---------------------------------------------------------------- Auth (Supabase Auth)
AUTH_MODE=supabase
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Service role key HANYA di backend. Jangan pernah dipakai di web/Android.
SUPABASE_SERVICE_ROLE_KEY=
# Email yang otomatis menjadi admin saat login pertama (pisahkan dengan koma)
BOOTSTRAP_ADMIN_EMAILS=admin@contoh.co.id

# ---------------------------------------------------------------- Alert Telegram (opsional)
# Token bot dari @BotFather. Chat ID & on/off diatur di dashboard > Pengaturan > Alert.
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------- Jobs
# true pada SATU instance saja (monitor perangkat, webhook, expiry, retensi)
JOBS_ENABLED=true
