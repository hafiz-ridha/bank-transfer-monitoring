<?xml version="1.0" encoding="utf-8"?>
<!--
  RELEASE: hanya HTTPS. Semua lalu lintas cleartext (http://) ditolak.
  Build debug memakai berkas pengganti di src/debug/res/xml/network_security_config.xml.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
