<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG SAJA (menggantikan konfigurasi release).

  Network Security Config tidak dapat menyatakan rentang IP (mis. 192.168.0.0/16), sehingga
  cleartext diizinkan di sini dan dibatasi di kode aplikasi (core/UrlPolicy.kt): pada build debug,
  http:// hanya diterima untuk localhost, 127.0.0.1, 10.0.2.2 (emulator), *.local, dan rentang
  LAN privat 10.x.x.x / 172.16-31.x.x / 192.168.x.x. Build release menolak semua http://.

  Sertifikat CA "user" diizinkan agar server pengembangan HTTPS dengan sertifikat lokal (mkcert)
  dapat diuji. Ini TIDAK berlaku untuk release.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
